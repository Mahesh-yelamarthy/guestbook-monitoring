{
  "title": "Guestbook Overview",
  "uid": "guestbook-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "guestbook",
    "pulumi"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Frontend scrape health",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(up{namespace=\"${guestbookNamespace}\",job=\"frontend\"})",
          "legendFormat": "frontend targets up"
        }
      ]
    },
    {
      "id": 2,
      "title": "Frontend request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{namespace=\"${guestbookNamespace}\"}[5m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis exporter health",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(redis_up{namespace=\"${guestbookNamespace}\"})",
          "legendFormat": "redis targets up"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis connected clients",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "redis_connected_clients{namespace=\"${guestbookNamespace}\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Frontend HPA replicas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"${guestbookNamespace}\",horizontalpodautoscaler=\"frontend\"}",
          "legendFormat": "current replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"${guestbookNamespace}\",horizontalpodautoscaler=\"frontend\"}",
          "legendFormat": "max replicas"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"${guestbookNamespace}\",horizontalpodautoscaler=\"frontend\"}",
          "legendFormat": "min replicas"
        }
      ]
    }
  ]
}
